# Frontend environment variables

# VITE_API_URL (optional): base URL the app prepends to every API path
# (e.g. /exercises, /auth/login). Leave unset/commented out for local dev
# (npm run dev) and for docker-compose — in both cases a same-origin proxy
# (vite.config.js's dev proxy, or nginx.conf in Docker) forwards API paths
# to the backend, so no URL is needed.
#
# Only set this if the frontend and backend are deployed without a shared
# proxy (e.g. two separate hosts/domains):
# VITE_API_URL=https://api.example.com
