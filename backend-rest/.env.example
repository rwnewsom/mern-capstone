# MongoDB Connection Configuration
# Choose ONE option below based on your development setup

# OPTION 1: Local MongoDB (via Docker Compose - Recommended for quick start)
# Use this if running 'docker-compose up' to get a local MongoDB container
# MONGODB_CONNECT_STRING=mongodb://root:password@mongodb:27017/?authSource=admin

# OPTION 2: Local MongoDB (Manual installation - if running MongoDB locally)
# Use this if you have MongoDB installed and running on your machine
# MONGODB_CONNECT_STRING=mongodb://localhost:27017/exercise-tracker

# OPTION 3: MongoDB Atlas (Cloud-hosted - for production or remote development)
# Sign up at https://www.mongodb.com/cloud/atlas (free tier available)
# Replace credentials and cluster name with your actual Atlas details
MONGODB_CONNECT_STRING=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=exercise-tracker

PORT=3000
JWT_SECRET=your_jwt_secret_key_here
