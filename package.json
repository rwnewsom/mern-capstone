{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "backend-rest/**/*.{js,mjs}": [
      "cd backend-rest && npx prettier --write",
      "cd backend-rest && npx eslint --report-unused-disable-directives --max-warnings 0"
    ],
    "frontend-react/**/*.{js,jsx}": [
      "cd frontend-react && npx prettier --write",
      "cd frontend-react && npx eslint --report-unused-disable-directives --max-warnings 0"
    ]
  }
}
