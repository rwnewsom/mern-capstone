{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "backend-rest/**/*.{js,mjs}": [
      "backend-rest/node_modules/.bin/prettier --write",
      "cd backend-rest && npx eslint"
    ],
    "frontend-react/**/*.{js,jsx}": [
      "frontend-react/node_modules/.bin/prettier --write",
      "cd frontend-react && npx eslint"
    ]
  }
}
